# Strapi CMS — Bird Database
# Set these in your production environment (.env.local for local dev, and in
# Vercel → Project → Settings → Environment Variables for deploys).

# Server-side URL (used by API routes / server components)
STRAPI_URL=https://your-instance.example.com
# Public URL (used by client components to resolve media). Same backend as above.
NEXT_PUBLIC_STRAPI_URL=https://your-instance.example.com
# Generate a full-access API token in Strapi Admin → Settings → API Tokens
STRAPI_API_TOKEN=your-api-token-here
